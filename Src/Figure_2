# Volcano Plot
```{r}
Proteome_protein_quant <- Proteome_protein_quant[complete.cases(Proteome_protein_quant[, grep("WT", colnames(Proteome_protein_quant))]), ]

# Convert the data to a DGEList for use with edgeR/limma
df <- Proteome_protein_quant
df <- df[complete.cases(df[, grep("WT", colnames(df))]), ]

df <- as.data.frame(df)
df <- df[!is.na(df$PG.ProteinGroups), ]

write.xlsx(df, "//ait-pdfs.win.dtu.dk/Department/Bio/MBT-g-Cell-Signaling-Architecture/People Folders/Canbay Vahap/Dermokine_Paper/Main/Supplementary_Table_3_v2.xlsx")

names(df) <- gsub(" ", ".", names(df))
names(df) <- gsub("/", ".", names(df))
df = na.omit(df)

#df$unique_genes <- make.names(df$PG.Genes, unique = TRUE)
#rownames(df) <- df$unique_genes

counts <- df[, -(1:3)]
rownames(counts) <- make.unique(df$PG.Genes)
#counts = log2(counts)
dge <- DGEList(counts = counts)

# Normalize the data
dge <- calcNormFactors(dge)

# Design matrix
#group <- factor(gsub("\\s\\d+$", "", colnames(dge))) This is if I dont change the names 

group <- factor(gsub("(\\.KO)?\\_\\d+$", "", colnames(dge))) # THis is if I change the naming above
design <- model.matrix(~0 + group)
colnames(design) <- levels(group)

# Estimate dispersion
dge <- estimateDisp(dge, design)
v <- voom(dge, design, plot=FALSE)

contrasts <- makeContrasts(
  BG_vs_WT = DMKN_BG_KO - WT,
  AB_vs_WT = DMKN_AB_KO - WT,
  levels = design
)
# Fit the model and perform the tests
fit <- lmFit(v, design)
fit2  = contrasts.fit(fit, contrasts)
fit2 <- eBayes(fit2)

# Extract the p-values and log fold changes (contrasts) from your fit2 object
p_values <- fit2$p.value
logFC <- fit2$coefficients
# 
# # Create a data frame to hold the p-values and log fold changes
# df_plot <- data.frame(Contrast = colnames(logFC),
#                  Gene = rownames(logFC),
#                  logFC = as.vector(logFC),
#                  p_value = as.vector(p_values))

# Calculate -log10 of the p-values for the y-axis
#df_plot$logp <- -log10(df_plot$p_value)

# Create a list to hold the plots
volcano_plots <- list()

# Define thresholds
pvalue_threshold <- -log10(0.05)
logFC_threshold <- log2(1.5)


# Convert the row names into a column
df_plot <- data.frame(Gene = rownames(logFC), logFC = as.vector(logFC), p_value = as.vector(p_values))

# Make sure the contrasts are properly assigned to each row
df_plot$Contrast <- rep(colnames(logFC), each = nrow(logFC))


# Convert matrices to long format data frames
df_logFC <- as.data.frame(as.table(logFC))
df_p_values <- as.data.frame(as.table(p_values))

# Rename columns for clarity
colnames(df_logFC) <- c("Gene", "Contrast", "logFC")
colnames(df_p_values) <- c("Gene", "Contrast", "p_value")


# Merge the two data frames by Gene and Contrast
df_plot <- merge(df_logFC, df_p_values, by = c("Gene", "Contrast"))


# Calculate -log10 of the p-values for the y-axis
df_plot$logp <- -log10(df_plot$p_value)
genes_to_highlight <- c("DMKN", "DSG1", "FLG2", "KRT10", "KRT14","ASPRV1", "KLK6","KLK7", "EGFR", "ITGA6","KRTDAP", "SBSN", "BLMH", "CDH1", "DSC1", "CTNND1", "CTNNB1")

for (contrast in unique(df_plot$Contrast)) {
    # Subset the data for the current contrast
    df_sub <- df_plot[df_plot$Contrast == contrast, ]
    
    # Create a new column for color based on logFC
    df_sub$color <- ifelse(df_sub$logp > pvalue_threshold & df_sub$logFC > logFC_threshold, "red", ifelse(df_sub$logp > pvalue_threshold & df_sub$logFC < -logFC_threshold, "blue", "grey"))
    
    # Create the volcano plot
    Volcano_p <- ggplot(df_sub, aes(x = logFC, y = logp, color = color)) +
        geom_point(alpha = 0.4, size = 1.75) +
        geom_hline(yintercept = pvalue_threshold, linetype = "dashed") +
        geom_vline(xintercept = c(-logFC_threshold, logFC_threshold), linetype = "dashed") +
        theme_minimal() +
        scale_color_identity() + 
        geom_label_repel(data = subset(df_sub, Gene %in% genes_to_highlight), aes(label = Gene), size = 3, color = "black",label.size = NA, fill = NA, segment.color = "black",segment.size = 0.5,box.padding = 1.5, fontface = "bold", nudge_x = c(-3,3)) +
        ggtitle(paste("Volcano plot for", contrast)) +
        xlab("Log2 fold change") +
        ylab("-Log10 p-value") +
        coord_cartesian(xlim = c(min(df_plot$logFC), max(df_plot$logFC)), ylim = c(0, max(df_plot$logp)))
    
    # Add the plot to the list
    volcano_plots[[contrast]] <- Volcano_p
}



pdf("//ait-pdfs.win.dtu.dk/Department/Bio/MBT-g-Cell-Signaling-Architecture/People Folders/Canbay Vahap/Dermokine_Paper/Supplementary/Volcano_Plots_KO.pdf")
grid.arrange(grobs = volcano_plots, ncol = 2)
dev.off()
