# Extract sig Hits from LIMMA
```{r}
# Define the thresholds
pvalue_threshold <- -log10(0.05) # Adjust the p-value threshold as needed
logFC_threshold <- 0.58 # Adjust the log fold change threshold as needed

# Initialize lists to store the top candidates
top_sig_increase <- list()
top_sig_decrease <- list()

for (contrast in unique(df_plot$Contrast)) {
  # Subset the data for the current contrast
  df_sub <- df_plot[df_plot$Contrast == contrast, ]
  
  # Sort by logp value in descending order to get the most significant genes on top
  df_sub <- df_sub[order(-df_sub$logp),]
  
  # Extract top 20 genes with significant increase
  top_sig_increase[[contrast]] <- head(df_sub$Gene[df_sub$logp > pvalue_threshold & df_sub$logFC > logFC_threshold], 20)
  
  # Extract top 20 genes with significant decrease
  top_sig_decrease[[contrast]] <- head(df_sub$Gene[df_sub$logp > pvalue_threshold & df_sub$logFC < -logFC_threshold], 20)
}

# Now you have two lists: top_sig_increase and top_sig_decrease
# containing the top 20 candidates for each contrast


sig_increase <- list()
A <- list()

# Loop through each contrast
for (contrast in unique(df_plot$Contrast)) {
    # Subset the data for the current contrast
    df_sub <- df_plot[df_plot$Contrast == contrast, ]
    
    # Extract genes with significant increase and decrease
    sig_increase[[contrast]] <- df_sub$Gene[df_sub$logp > pvalue_threshold & df_sub$logFC > logFC_threshold]
    sig_decrease[[contrast]] <- df_sub$Gene[df_sub$logp > pvalue_threshold & df_sub$logFC < -logFC_threshold]
}


sig_increase <- lapply(sig_increase, as.character)

