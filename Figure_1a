import seaborn as sns
from Bio import SeqIO
from dna_features_viewer import GraphicFeature, GraphicRecord
from Bio.Seq import Seq
import matplotlib.pyplot as plt

# Define the sequence files and their corresponding exons files
files = [
    (r"C:\Users\vahcan\Downloads\DMKN_Alpha_DNA.fa", r"C:\Users\vahcan\Downloads\DMKN_alpha.exons.fa"),
    (r"C:\Users\vahcan\Downloads\DMKN_Beta_DNA.fa", r"C:\Users\vahcan\Downloads\DMKN_beta.exons.fa"),
    (r"C:\Users\vahcan\Downloads\DMKN_Gamma_DNA.fa", r"C:\Users\vahcan\Downloads\DMKN_gamma.exons.fa"),
]

# Define the gRNA sequences
gRNA_sequences = [
    "GGATACCCCGGAAACTCAGC",
    str(Seq("CTCGGGATTGCACAAAGCCT").reverse_complement()),
    "ACCCGTGGGCACTGAGACAA",
]

# Calculate the maximum sequence length
max_length = max(len(SeqIO.read(file, "fasta").seq) for file, _ in files)

# Create a subplot for each pair of sequence and exons files
fig, axs = plt.subplots(len(files), 1, figsize=(10, len(files) * 2), gridspec_kw={'hspace': 0.1})

# Read the beta sequence and its exons
beta_sequence = SeqIO.read(files[1][0], "fasta").seq
beta_exons = [exon.seq for exon in SeqIO.parse(files[1][1], "fasta")]

# Define a larger palette of 20 distinct colors
palette = sns.color_palette("hsv", 20)

# Create a dictionary mapping exon sequences to colors
exon_colors = {str(exon): palette[i % len(palette)] for i, exon in enumerate(beta_exons)}

# Store the start and end positions of the beta exons
beta_exon_positions = []
for exon_sequence in beta_exons:
    start = beta_sequence.find(exon_sequence)
    if start != -1:  # if the exon sequence was found in the main sequence
        end = start + len(exon_sequence)
        beta_exon_positions.append((start, end))

# Calculate the offset for the alpha sequence
alpha_offset = beta_exon_positions[-1][1] - len(SeqIO.read(files[0][0], "fasta").seq)

# Calculate the offset for the gamma sequence
gamma_offset = beta_exon_positions[0][0]

for ax, (sequence_file, exons_file) in zip(axs, files):
    # Read the sequence file
    sequence = SeqIO.read(sequence_file, "fasta").seq

    # Read the exons file and create features
    features = []
    for exon_record in SeqIO.parse(exons_file, "fasta"):
        exon_sequence = exon_record.seq
        start = sequence.find(exon_sequence)
        if start != -1:  # if the exon sequence was found in the main sequence
            end = start + len(exon_sequence)
            # If the sequence is the alpha sequence, adjust the start and end positions to align with the rightmost exon of the beta sequence
            if sequence_file == files[0][0]:
                start += alpha_offset
                end += alpha_offset
            # If the sequence is the gamma sequence, adjust the start and end positions to align with the start of the beta sequence
            elif sequence_file == files[2][0]:
                start += gamma_offset
                end += gamma_offset
            color = exon_colors.get(str(exon_sequence), "#000000")  # use a default color if the exon sequence is not in the dictionary
            label = exon_record.id.replace(".", " ")  # replace the dot in the exon name with a space
            features.append(GraphicFeature(start=start, end=end, strand=+1, color=color, label=label, linewidth=0.5))

    # Add the gRNAs as new features
    for i, gRNA_sequence in enumerate(gRNA_sequences, 1):
        start = sequence.find(gRNA_sequence)
        if start != -1:  # if the gRNA sequence was found in the main sequence
            end = start + len(gRNA_sequence)
            # If the sequence is the alpha sequence, adjust the start and end positions to align with the rightmost exon of the beta sequence
            if sequence_file == files[0][0] and i > 1:
                start += alpha_offset
                end += alpha_offset
            features.append(GraphicFeature(start=start, end=end, strand=+1, color="#FF00FF", label=f"gRNA {i}", linewidth=0.5))

    # Create a GraphicRecord with the sequence length and plot it
    record = GraphicRecord(sequence_length=max_length, features=features)
    record.plot(ax=ax, with_ruler=sequence_file == files[-1][0])  # only display the ruler for the last sequence

